{
  "name": "agr-ai-curation-midscene-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "check": "npm run typecheck && npm run test:offline && npm run validate:yaml",
    "preflight": "tsx src/preflight.ts",
    "run": "tsx src/run.ts",
    "test:offline": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:yaml": "tsx src/validate-yaml.ts"
  },
  "dependencies": {
    "@midscene/test": "1.12.2",
    "@midscene/web": "1.12.2",
    "@playwright/test": "1.62.1",
    "playwright": "1.62.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
