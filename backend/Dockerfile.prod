# NOTE: Build from the repository root context so package manifests and hashed
# per-package lockfiles under packages/ are available at image build time:
#   docker build -f backend/Dockerfile.prod .

FROM public.ecr.aws/docker/library/python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.lock.txt backend/requirements.txt ./

RUN python -m venv "${VIRTUAL_ENV}" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.lock.txt

# Pre-execution security check: scan /opt/venv for unexpected .pth files using
# the isolated base interpreter (-I -S, skipping site.py) BEFORE invoking
# /opt/venv/bin/python or /opt/venv/bin/pip for local installs or package builds.
RUN KNOWN_PTH="a1_coverage.pth distutils-precedence.pth sphinxcontrib_jsmath-1.0.1-py3.7-nspkg.pth" \
    /usr/local/bin/python3 -I -S -c '\
import os, pathlib, sys; \
known = set(os.environ["KNOWN_PTH"].split()); \
root = pathlib.Path(os.environ["VIRTUAL_ENV"]) / "lib"; \
unknown = [str(pth) for pth in sorted(root.rglob("*.pth")) if pth.name not in known]; \
print("SECURITY: Unknown .pth file(s) detected: " + " ".join(unknown) + "\nIf legitimate, add to KNOWN_PTH whitelist in Dockerfile.prod.") or sys.exit(1) if unknown else print("SECURITY: .pth whitelist check passed (base /opt/venv)")'

COPY backend/cost_pricing/ /tmp/cost_pricing/
RUN pip install --no-cache-dir --no-deps /tmp/cost_pricing
COPY backend/auth_runtime/ /tmp/auth_runtime/
RUN pip install --no-cache-dir --no-deps /tmp/auth_runtime

# Bake per-package isolated environments into /opt/package-envs/<package_id> from
# each package's hashed lockfile (--require-hashes --no-deps --no-build-isolation).
# Each package venv is scanned against KNOWN_PTH BEFORE its interpreter runs pip check.
# Only copy the minimal package-discovery/builder modules plus packages/ so
# unrelated backend code edits keep this layer cached.
RUN mkdir -p /build/pkg_builder/src/lib/packages \
    && touch /build/pkg_builder/src/__init__.py \
             /build/pkg_builder/src/lib/__init__.py \
             /build/pkg_builder/src/lib/packages/__init__.py
COPY backend/src/lib/packages/build_package_envs.py \
     backend/src/lib/packages/discovery.py \
     backend/src/lib/packages/env_manager.py \
     backend/src/lib/packages/manifest_loader.py \
     backend/src/lib/packages/models.py \
     backend/src/lib/packages/paths.py \
     backend/src/lib/packages/registry.py \
     /build/pkg_builder/src/lib/packages/
COPY packages/ /build/packages/

RUN KNOWN_PTH="a1_coverage.pth distutils-precedence.pth sphinxcontrib_jsmath-1.0.1-py3.7-nspkg.pth" && \
    PYTHONPATH=/build/pkg_builder python -m src.lib.packages.build_package_envs \
    --packages-dir /build/packages \
    --output-dir /opt/package-envs \
    --constraints /build/requirements.lock.txt \
    --host-python /usr/local/bin/python3 \
    --allowed-pth "${KNOWN_PTH}"

# Final post-install security check across BOTH /opt/venv and every prebuilt
# package venv under /opt/package-envs using isolated base Python (-I -S).
RUN KNOWN_PTH="a1_coverage.pth distutils-precedence.pth sphinxcontrib_jsmath-1.0.1-py3.7-nspkg.pth" \
    /usr/local/bin/python3 -I -S -c '\
import os, pathlib, sys; \
known = set(os.environ["KNOWN_PTH"].split()); \
roots = [pathlib.Path(os.environ["VIRTUAL_ENV"]) / "lib"]; \
pkg_root = pathlib.Path("/opt/package-envs"); \
pkg_envs = sorted(p / "venv" / "lib" for p in pkg_root.iterdir() if (p / "venv" / "lib").is_dir()) if pkg_root.is_dir() else []; \
roots.extend(pkg_envs); \
unknown = [str(pth) for root in roots for pth in sorted(root.rglob("*.pth")) if pth.name not in known]; \
print("SECURITY: Unknown .pth file(s) detected: " + " ".join(unknown) + "\nIf legitimate, add to KNOWN_PTH whitelist in Dockerfile.prod.") or sys.exit(1) if unknown else print(f"SECURITY: .pth whitelist check passed ({len(roots)} environment(s))")'

FROM public.ecr.aws/docker/library/python:3.11-slim AS runtime

ARG APP_USER=agr
ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/app/backend:/app/backend/src \
    AGR_RUNTIME_ROOT=/runtime \
    AGR_PACKAGE_ENV_BOOTSTRAP_MODE=prebuilt \
    AGR_PREBUILT_PACKAGE_ENVS_DIR=/opt/package-envs

WORKDIR /app/backend

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ripgrep \
    && groupadd --gid "${APP_GID}" "${APP_USER}" \
    && useradd --uid "${APP_UID}" --gid "${APP_GID}" \
        --create-home --home-dir "/home/${APP_USER}" --shell /usr/sbin/nologin "${APP_USER}" \
    && mkdir -p /runtime/config /runtime/packages /runtime/state \
    && chown -R "${APP_UID}:${APP_GID}" /app/backend /runtime "/home/${APP_USER}" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder --chown=${APP_UID}:${APP_GID} /opt/venv /opt/venv
# Keep image-baked package environments root-owned (read-only to the app user)
# so runtime processes cannot mutate verified site-packages.
COPY --from=builder /opt/package-envs /opt/package-envs
COPY --chown=${APP_UID}:${APP_GID} backend/src/ ./src/
COPY --chown=${APP_UID}:${APP_GID} backend/main.py ./
COPY --chown=${APP_UID}:${APP_GID} backend/alembic/ ./alembic/
COPY --chown=${APP_UID}:${APP_GID} backend/alembic.ini ./
# Isolated package environments verify against the backend lock fingerprint.
COPY --chown=${APP_UID}:${APP_GID} backend/requirements.lock.txt ./

EXPOSE 8000

USER ${APP_UID}:${APP_GID}

# No CMD is set here: runtime_entrypoint computes the default production
# server command, and operators can still append explicit args when needed.
ENTRYPOINT ["python", "-m", "src.lib.runtime_entrypoint"]
