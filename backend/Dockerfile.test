FROM python:3.11-slim

WORKDIR /app/backend

# Install build dependencies first (rarely changes)
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files first for better caching
COPY requirements.lock.txt requirements.txt ./

# Upgrade pip first
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install Python dependencies from the pinned lockfile.
# PDF extraction now runs through external services in tests, so we do not
# install the historical floating unstructured ML stack in this image.
RUN pip install --no-cache-dir -r requirements.lock.txt

# Install runtime system dependencies after Python deps
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libmagic1 \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy source code and tests last (changes most frequently)
COPY src/ ./src/
COPY tests/ ./tests/
COPY main.py pytest.ini ./

# Set Python path
ENV PYTHONPATH=/app/backend:/app/backend/src:$PYTHONPATH

# Keep interpreter caches out of bind-mounted source trees. This path is
# container-local for both rootful and rootless Docker test runs.
ENV PYTHONPYCACHEPREFIX=/tmp/agr-ai-curation-python-pycache

# Default command runs all tests
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]
