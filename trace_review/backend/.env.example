# ============================================================================
# Trace Review Backend - Environment Configuration
# ============================================================================
#
# OPTION 1: Add TRACE_REVIEW_* variables to the main .env file
#
#   The main ~/.agr_ai_curation/.env now supports TRACE_REVIEW_* prefixed
#   variables for trace_review configuration. This is the simpler option
#   since everything is in one file.
#
# OPTION 2: Use a separate trace_review .env file (this file)
#
#   mkdir -p ~/.agr_ai_curation/trace_review
#   cp .env.example ~/.agr_ai_curation/trace_review/.env
#   chmod 600 ~/.agr_ai_curation/trace_review/.env
#
# USAGE:
#
#   make trace-review           # Start via main docker-compose
#   make trace-review-standalone # Start independently
#
# ============================================================================

# ===========================
# AWS Cognito Configuration
# ===========================

# AWS Cognito Region
COGNITO_REGION=us-east-1

# Cognito User Pool ID (format: us-east-1_XXXXXXXXX)
COGNITO_USER_POOL_ID=

# Cognito Client ID (App Client ID from User Pool)
COGNITO_CLIENT_ID=

# Cognito Client Secret (App Client Secret from User Pool)
COGNITO_CLIENT_SECRET=

# Cognito Domain (format: https://your-domain.auth.us-east-1.amazoncognito.com)
COGNITO_DOMAIN=

# Cognito Redirect URI
# Development: http://localhost:3001/api/auth/callback
# Production:  https://your-domain.com/api/auth/callback
COGNITO_REDIRECT_URI=http://localhost:3001/api/auth/callback


# ===========================
# Development Mode
# ===========================

# Enable dev mode to bypass Cognito authentication (true/false)
# IMPORTANT: Set to false in production!
DEV_MODE=true

# Use secure cookies (HTTPS only)
# Development: false (HTTP)
# Production:  true (HTTPS)
SECURE_COOKIES=false


# ===========================
# Langfuse Configuration (Remote/Primary)
# ===========================

# Langfuse Host URL (Alliance internal instance, requires VPN)
# DNS alias pending setup - see KANBAN-957
LANGFUSE_HOST=http://langfuse-internal.alliancegenome.org:3000

# Langfuse Public Key
LANGFUSE_PUBLIC_KEY=

# Langfuse Secret Key
LANGFUSE_SECRET_KEY=


# ===========================
# Langfuse Configuration (Local/Alternative)
# ===========================
# Optional: Configure a local Langfuse instance as an alternative source
# Use source="local" in API calls to use these credentials instead

# Local Langfuse Host URL
LANGFUSE_LOCAL_HOST=http://localhost:3000

# Local Langfuse Public Key
LANGFUSE_LOCAL_PUBLIC_KEY=

# Local Langfuse Secret Key
LANGFUSE_LOCAL_SECRET_KEY=

# Maximum observations requested per cursor-paginated v2 read (default: 1000)
TRACE_REVIEW_LANGFUSE_OBSERVATION_PAGE_LIMIT=1000

# Maximum observation rows inspected by one cursor-paginated trace search (default: 10000)
TRACE_REVIEW_LANGFUSE_SEARCH_OBSERVATION_LIMIT=10000

# Maximum Langfuse API requests across discovery and exact hydration in one trace search (default: 200)
TRACE_REVIEW_LANGFUSE_SEARCH_REQUEST_LIMIT=200

# Timeout in seconds for each Langfuse observation or score request (default: 30)
TRACE_REVIEW_LANGFUSE_REQUEST_TIMEOUT_SECONDS=30


# ===========================
# Server Configuration
# ===========================

# Backend Host (for CORS, redirects, etc.)
BACKEND_HOST=localhost

# Backend Port
BACKEND_PORT=8001

# Frontend URL (for redirects after login/logout)
# Development: http://localhost:3001
# Production:  https://your-domain.com
FRONTEND_URL=http://localhost:3001
