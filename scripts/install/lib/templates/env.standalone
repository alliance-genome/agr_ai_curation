# Standalone deployment environment template.
# This file is the authoritative env template for standalone installs.

OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AUTH_PROVIDER=oidc
DEV_MODE=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_GROUP_CLAIM=groups

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_AUTH=CHANGE_ME_REDIS_AUTH
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/ai_curation

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
SALT=CHANGE_ME_SALT
ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX
LANGFUSE_LOCAL_NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
LANGFUSE_LOCAL_SALT=CHANGE_ME_SALT
LANGFUSE_LOCAL_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX

CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_LANGFUSE_INIT_USER_PASSWORD

# Must match init keys.
LANGFUSE_PUBLIC_KEY=${LANGFUSE_INIT_PROJECT_PUBLIC_KEY}
LANGFUSE_SECRET_KEY=${LANGFUSE_INIT_PROJECT_SECRET_KEY}
LANGFUSE_LOCAL_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_LOCAL_SECRET_KEY=sk-lf-CHANGE_ME

# Must equal MINIO_ROOT_PASSWORD.
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

LLM_PROVIDER_STRICT_MODE=false
RUN_DB_BOOTSTRAP_ON_START=true
RUN_DB_MIGRATIONS_ON_START=true
HEALTH_CHECK_STRICT_MODE=true
HEALTH_CHECK_REQUIRE_EXTERNAL_VALIDATION_DEPS=true
HEALTH_CHECK_REQUIRE_LITERATURE_DB=true
SECURE_COOKIES=true

# Agent Studio/provider-boundary operational limits. These defaults match
# .env.example; lower page/chunk limits to reduce provider context and source
# work, or raise them only with provider-envelope validation.
AGENT_STUDIO_PROVIDER_TOOL_RESULT_INLINE_MAX_CHARS=12000

# Durable chat recall and Workshop/prompt inspection.
AGENT_STUDIO_CHAT_HISTORY_PAGE_SIZE=25
AGENT_STUDIO_CHAT_RECALL_PAGE_SIZE=10
AGENT_STUDIO_CHAT_RECALL_CHUNK_MAX_CHARS=8000
AGENT_STUDIO_WORKSHOP_PROMPT_MAX_CHARS=40000
AGENT_STUDIO_WORKSHOP_CONTEXT_PROMPT_MAX_CHARS=12000
AGENT_STUDIO_WORKSHOP_CONTEXT_GROUP_PROMPT_MAX_CHARS=6000
AGENT_STUDIO_WORKSHOP_PROMPT_CHUNK_MAX_CHARS=8000
AGENT_STUDIO_PROMPT_INSPECTION_CHUNK_MAX_CHARS=8000

# Installed tool and flow catalog paging/detail boundaries.
AGENT_STUDIO_TOOL_INVENTORY_DEFAULT_ITEMS=20
AGENT_STUDIO_TOOL_INVENTORY_MAX_ITEMS=50
AGENT_STUDIO_TOOL_INVENTORY_SUMMARY_MAX_CHARS=300
AGENT_STUDIO_TOOL_INVENTORY_RESULT_MAX_CHARS=8000
AGENT_STUDIO_TOOL_DETAILS_RESULT_MAX_CHARS=8000
AGENT_STUDIO_TOOL_DETAILS_CHUNK_MAX_CHARS=6000
AGENT_STUDIO_FLOW_TEMPLATE_DEFAULT_ITEMS=5
AGENT_STUDIO_FLOW_TEMPLATE_MAX_ITEMS=20
AGENT_STUDIO_FLOW_CATALOG_RESULT_MAX_CHARS=8000
AGENT_STUDIO_FLOW_CATALOG_CHUNK_MAX_CHARS=6000

# TraceReview, trace search, and service-log paging boundaries.
AGENT_STUDIO_TRACE_REVIEW_PAGE_SIZE=10
AGENT_STUDIO_TRACE_REVIEW_AGGREGATE_PAGE_SIZE=5
AGENT_STUDIO_TRACE_SEARCH_DEFAULT_LIMIT=25
AGENT_STUDIO_TRACE_SEARCH_MAX_LIMIT=100
AGENT_STUDIO_TRACE_SEARCH_FILTER_MAX_CHARS=256
AGENT_STUDIO_TRACE_REVIEW_SUMMARY_MAX_CHARS=200
AGENT_STUDIO_TRACE_REVIEW_CHUNK_MAX_CHARS=8000
TRACE_REVIEW_PAYLOAD_PREVIEW_MAX_CHARS=500
AGENT_STUDIO_SERVICE_LOG_DEFAULT_LINES=20
AGENT_STUDIO_SERVICE_LOG_MAX_LINES=100
AGENT_STUDIO_SERVICE_LOG_SOURCE_QUERY_MAX_LINES=2000
AGENT_STUDIO_SERVICE_LOG_PAGE_MAX_CHARS=8000
AGENT_STUDIO_SERVICE_LOG_TIMEOUT_SECONDS=15
AGENT_STUDIO_SERVICE_LOG_DEFAULT_LOOKBACK_MINUTES=1440
AGENT_STUDIO_SERVICE_LOG_MAX_LOOKBACK_MINUTES=10080

# Package diagnostics and flow authoring/inspection boundaries.
AGENT_STUDIO_PACKAGE_DIAGNOSTIC_PAGE_DEFAULT_ITEMS=10
AGENT_STUDIO_PACKAGE_DIAGNOSTIC_PAGE_MAX_ITEMS=25
AGENT_STUDIO_PACKAGE_DIAGNOSTIC_RESULT_MAX_CHARS=8000
AGENT_STUDIO_PACKAGE_DIAGNOSTIC_CHUNK_MAX_CHARS=6000
AGENT_STUDIO_PACKAGE_DIAGNOSTIC_SCALAR_PREVIEW_MAX_CHARS=256
FLOW_DEFINITION_MAX_NODES=31
AGENT_STUDIO_FLOW_MAX_STEPS=30
AGENT_STUDIO_FLOW_NAME_MAX_CHARS=255
AGENT_STUDIO_FLOW_DESCRIPTION_MAX_CHARS=2000
AGENT_STUDIO_FLOW_STEP_GOAL_MAX_CHARS=500
AGENT_STUDIO_FLOW_CUSTOM_INSTRUCTIONS_MAX_CHARS=2000
AGENT_STUDIO_FLOW_OUTPUT_FILENAME_TEMPLATE_MAX_CHARS=255
AGENT_STUDIO_FLOW_INSPECTION_PAGE_LIMIT=20
AGENT_STUDIO_FLOW_INSPECTION_CHUNK_MAX_CHARS=4000

# Agent Studio code browsing and domain-runtime inspection boundaries.
CODEBASE_SEARCH_TIMEOUT_SECONDS=30
CODEBASE_READ_MAX_LINES=400
CODEBASE_RESULT_MAX_CHARS=8000
CODEBASE_LONG_LINE_CHUNK_MAX_CHARS=6000
CODEBASE_SEARCH_MAX_RESULTS=100
CODEBASE_FILE_LIST_MAX_RESULTS=200
DOMAIN_ENVELOPE_DEFAULT_LIMIT=10
DOMAIN_ENVELOPE_MAX_LIMIT=50
DOMAIN_PACK_VALIDATION_PLAN_DEFAULT_LIMIT=3
DOMAIN_PACK_VALIDATION_PLAN_MAX_LIMIT=4
DOMAIN_RUNTIME_INSPECTION_DEFAULT_LIMIT=3
DOMAIN_RUNTIME_INSPECTION_MAX_LIMIT=4
DOMAIN_ENVELOPE_MAX_SUMMARY_JSON_CHARS=4000
DOMAIN_ENVELOPE_MAX_LOOKUP_ATTEMPTS=25
DOMAIN_ENVELOPE_MAX_VALIDATOR_SUMMARIES=25
DOMAIN_ENVELOPE_MAX_FIELD_PATHS=150
DOMAIN_REFERENCE_MAX_VALUES=50

# Package GO/AGR query and typed gene-product resolver bounds. Package
# subprocesses inherit these values from the production backend.
GO_ANNOTATIONS_REQUEST_TIMEOUT_SECONDS=30
GO_ANNOTATIONS_PAGE_MAX_RESULTS=500
AGR_DEFAULT_LIMIT=100
AGR_HARD_MAX=500
RNA_GENE_PRODUCT_REQUEST_TIMEOUT_SECONDS=10
RNA_GENE_PRODUCT_CACHE_TTL_SECONDS=300
RNA_GENE_PRODUCT_CACHE_MAX_ENTRIES=256
RNA_GENE_PRODUCT_MAX_CANDIDATES=25

# Shared backend and frontend Nginx PDF upload limit (500 MiB by default).
# Must not exceed the persisted PostgreSQL INTEGER capacity of 2147483647 bytes.
PDF_MAX_FILE_SIZE_BYTES=524288000
# Maximum pages admitted for PDF uploads before extraction begins.
PDF_UPLOAD_MAX_PAGE_COUNT=300
# PDF extraction processing timeout in seconds. Keep this high enough for large PDFs.
PDF_EXTRACTION_TIMEOUT=3600

# Weaviate is internal-only and requires API-key authentication in production.
WEAVIATE_AUTH_ENABLED=true
WEAVIATE_API_KEY=CHANGE_ME_WEAVIATE_API_KEY
WEAVIATE_API_KEY_USER=curation-backend

# Alliance standalone installs default to Bedrock reranking to match current behavior.
# Bedrock mode requires AWS credentials from an IAM role, environment credentials,
# or a valid AWS_PROFILE. Leave AWS_PROFILE unset when using an instance/task role.
# Set local_transformers only when you will also run the local reranker container,
# or set none to keep retrieval order without post-retrieval reranking.
RERANK_PROVIDER=bedrock_cohere
BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0
RERANKER_URL=http://reranker-transformers:8080

LANGFUSE_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres
LANGFUSE_LOCAL_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres

# Fresh Langfuse v4 defaults. Existing v3 deployments must override these with
# the staged values in docs/developer/guides/LANGFUSE_V4_MIGRATION.md before the
# first v4 start, then advance to these steady-state values after verification.
LANGFUSE_MIGRATION_V4_WRITE_MODE=events_only
LANGFUSE_MIGRATION_V4_NATIVE_OTEL_BEHAVIOUR=direct
LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=true
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=true
LANGFUSE_BACKGROUND_MIGRATION_V4_DROP_PID_TID_SORTING_TABLES=false
LANGFUSE_EVENT_PROPAGATION_STUCK_THRESHOLD_MINUTES=15
# Installer fills these with absolute paths under ~/.agr_ai_curation/.
# Leaving them blank preserves the compose-file defaults for manual runs.
AGR_RUNTIME_CONFIG_HOST_DIR=
AGR_RUNTIME_PACKAGES_HOST_DIR=
AGR_RUNTIME_STATE_HOST_DIR=
PDF_STORAGE_HOST_DIR=
FILE_OUTPUT_STORAGE_HOST_DIR=
WEAVIATE_DATA_HOST_DIR=
WEAVIATE_BACKUP_HOST_DIR=

# The installer rewrites these placeholders to a checkout-matched release tag
# or sha-<shortsha>. The production preflight rejects placeholders and latest.
BACKEND_IMAGE=public.ecr.aws/v4p5b7m9/agr-ai-curation-backend
BACKEND_IMAGE_TAG=CHANGE_ME_PINNED_RELEASE_TAG
FRONTEND_IMAGE=public.ecr.aws/v4p5b7m9/agr-ai-curation-frontend
FRONTEND_IMAGE_TAG=CHANGE_ME_PINNED_RELEASE_TAG
TRACE_REVIEW_BACKEND_IMAGE=public.ecr.aws/v4p5b7m9/agr-ai-curation-trace-review-backend
TRACE_REVIEW_BACKEND_IMAGE_TAG=CHANGE_ME_PINNED_RELEASE_TAG
TRACE_REVIEW_URL=http://trace_review_backend:8001
TRACE_REVIEW_INTERNAL_API_TOKEN=
TRACE_REVIEW_DEV_MODE=false
TRACE_REVIEW_SECURE_COOKIES=true
SENTRY_LOG_EVENT_LEVEL=
SENTRY_AI_CONTENT_PREVIEW_MAX_CHARS=2000
SENTRY_TRANSACTION_RETAINED_SPANS_MAX=50
TRACE_REVIEW_LANGFUSE_HOST=http://langfuse:3000
TRACE_REVIEW_LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
TRACE_REVIEW_LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
TRACE_REVIEW_LANGFUSE_LOCAL_HOST=http://langfuse:3000
TRACE_REVIEW_LANGFUSE_LOCAL_PUBLIC_KEY=${LANGFUSE_LOCAL_PUBLIC_KEY}
TRACE_REVIEW_LANGFUSE_LOCAL_SECRET_KEY=${LANGFUSE_LOCAL_SECRET_KEY}
TRACE_REVIEW_LANGFUSE_OBSERVATION_PAGE_LIMIT=1000
TRACE_REVIEW_LANGFUSE_REQUEST_TIMEOUT_SECONDS=30
TRACE_REVIEW_BACKEND_HOST=0.0.0.0
TRACE_REVIEW_BACKEND_HOST_PORT=8001
TRACE_REVIEW_BACKEND_PORT=8001
TRACE_REVIEW_FRONTEND_URL=http://localhost:3001
TRACE_REVIEW_CACHE_TTL_HOURS=1
